# ============================================================
# デジタル栞 — 環境変数
# このファイルをコピーして .env.local を作成してください
# Vercel にデプロイする場合は Dashboard > Settings > Environment Variables に設定
# ============================================================

# Supabase（必須）
# Supabase プロジェクトの Settings > API から取得
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Supabase Service Role Key（アカウント削除機能に必要）
# Settings > API > service_role から取得。絶対に公開しないこと
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Google Books API Key（任意・なくても動くが検索制限が厳しくなる）
# Google Cloud Console > APIs & Services > Credentials から取得
# GOOGLE_BOOKS_API_KEY=your-google-books-api-key-here

# RevenueCat Web Billing API Key（任意・Web上でのPro購入に必要）
# RevenueCat Dashboard > Project > Web Billing (rcb_ で始まるキー) から取得
# 未設定でも動作する: mobileで購入済みのProはWebでも有効にならず、無料制限のみ適用
# NEXT_PUBLIC_REVENUECAT_WEB_KEY=rcb_your-web-billing-key-here
