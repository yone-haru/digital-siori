{
  "expo": {
    "name": "Yondle",
    "slug": "yondle",
    "version": "1.0.0",
    "scheme": "yondle",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#F7F5EF"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.yondle.app"
    },
    "android": {
      "package": "com.yondle.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#F7F5EF"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "permissions": []
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-font",
      "expo-secure-store",
      "expo-file-system"
    ],
    "extra": {
      "eas": {
        "projectId": "4181fe68-a2d6-44fc-ab6b-8211a31eb633"
      }
    },
    "owner": "yoneharu"
  }
}
