# Supabase（ダッシュボード > Settings > API）
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here

# Google Books API（Google Cloud Console）
EXPO_PUBLIC_GOOGLE_BOOKS_API_KEY=your_google_books_api_key_here

# RevenueCat（RevenueCat ダッシュボード > API Keys）
EXPO_PUBLIC_REVENUECAT_IOS_KEY=appl_xxxxxxxxxxxxxxxxxxxxxxxxxx
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=goog_xxxxxxxxxxxxxxxxxxxxxxxxxx
